<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.desktopapp.controller.StaffController"
            stylesheets="@../css/staff.css"
            styleClass="content-pane">

    <VBox spacing="20"
          AnchorPane.topAnchor="20"
          AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20"
          AnchorPane.rightAnchor="20">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT">
            <Label text="👥 Staff Management" styleClass="header-title"/>
        </HBox>

        <!-- Add -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="+ Add Staff"
                    onAction="#handleAddStaff"
                    styleClass="btn-add"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label text="Records:" styleClass="info-text"/>
            <Label fx:id="lblRecordCount"
                   text="0 staff"
                   styleClass="info-text"/>
        </HBox>

        <!-- Action Buttons -->
        <HBox spacing="10">
            <Button fx:id="btnEdit"
                    text="✏️ Edit"
                    disable="true"
                    styleClass="btn-edit"/>

            <Button fx:id="btnDelete"
                    text="🗑️ Delete"
                    onAction="#handleDeleteStaff"
                    disable="true"
                    styleClass="btn-delete"/>

            <Button fx:id="btnView"
                    text="👁️ View"
                    onAction="#handleViewDetails"
                    disable="true"
                    styleClass="btn-view"/>
        </HBox>

        <!-- Table -->
        <TableView fx:id="tableStaff"
                   VBox.vgrow="ALWAYS"
                   prefHeight="450"
                   styleClass="table-view">

            <columns>
                <TableColumn fx:id="colStaffCode" text="Staff Code"/>
                <TableColumn fx:id="colName" text="Name"/>
                <TableColumn fx:id="colPosition" text="Position"/>
                <TableColumn fx:id="colMajor" text="Major"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

    </VBox>
</AnchorPane>
