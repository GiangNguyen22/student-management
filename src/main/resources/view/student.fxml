<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.desktopapp.controller.StudentController"
            stylesheets="@../css/student.css"
            styleClass="content-pane">

    <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="📚 Student Management" styleClass="header-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleRefresh" styleClass="btn-refresh">
                <graphic>
                    <ImageView>
                        <Image url="@../images/refresh.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <!-- Search & Add -->
        <VBox spacing="15">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtSearch" promptText="🔍 Search by StudentCode, Name, Email..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
                <Button onAction="#handleSearch" text="Search" styleClass="btn-search"/>
                <Button onAction="#handleAddStudent" text="+ Add Student" styleClass="btn-add"/>
            </HBox>

            <!-- Action Buttons & Records -->
            <HBox spacing="10">
                <Button onAction="#handleEditStudent" text="✏️ Edit" styleClass="btn-edit" disable="true" fx:id="btnEdit"/>
                <Button onAction="#handleDeleteStudent" text="🗑️ Delete" styleClass="btn-delete" disable="true" fx:id="btnDelete"/>
                <Button onAction="#handleViewDetails" text="👁️ View" styleClass="btn-view" disable="true" fx:id="btnView"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label text="Records: " styleClass="info-text"/>
                <Label text="0/0 students" styleClass="info-text" fx:id="lblRecordCount"/>
            </HBox>
        </VBox>

        <!-- Table -->
        <TableView fx:id="tableStudent" styleClass="table-view" prefHeight="450" onMouseClicked="#handleTableClick" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colStudentCode" text="StudentCode" prefWidth="90" resizable="true"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="180" resizable="true"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="200" resizable="true"/>
                <TableColumn fx:id="colMajor" text="Major" prefWidth="130" resizable="true"/>
                <TableColumn fx:id="colDob" text="DOB" prefWidth="110" resizable="true"/>
                <TableColumn fx:id="colStartYear" text="StartYear" prefWidth="80" resizable="true"/>
                <TableColumn fx:id="colGender" text="Gender" prefWidth="90" resizable="true"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Statistics -->
        <HBox alignment="CENTER_RIGHT" spacing="15">
            <Label text="📊 Statistics: " styleClass="info-text"/>
            <Label text="Male: 0 | Female: 0" styleClass="info-text" fx:id="lblGenderStats"/>
            <Label text="IT: 0 | KT: 0 | QTKD: 0" styleClass="info-text" fx:id="lblMajorStats"/>
        </HBox>

        <!-- Pagination -->
        <HBox alignment="CENTER" spacing="10">
            <Button text="Prev" onAction="#prevPage"/>
            <Label fx:id="lblPage"/>
            <Button text="Next" onAction="#nextPage"/>
        </HBox>

    </VBox>
</AnchorPane>
