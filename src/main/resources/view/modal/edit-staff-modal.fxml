<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.desktopapp.controller.action.EditStaffDialogController"
            stylesheets="@../css/edit-student.css"
            styleClass="modal-pane">

    <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <!-- Header -->
        <Label text="✏️ Chỉnh Sửa Nhân Viên" styleClass="modal-title"/>

        <!-- Form -->
        <GridPane hgap="12" vgap="12">
            <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtUsername" promptText="Nhập username" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
            <Label text="Họ tên:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtName" promptText="Nhập họ tên nhân viên" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label text="Chức vụ:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPosition" promptText="Nhập chức vụ" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label text="Ngành:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMajor" promptText="Nhập ngành" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>

            <Label text="Mã NV:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtStaffCode" promptText="Nhập mã nhân viên" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
            <Label text="Giới tính:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtGender" promptText="Nhập giới tính" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
        </GridPane>

        <!-- Buttons -->
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button text="Hủy" onAction="#handleCancel" styleClass="btn-cancel"/>
            <Button text="Lưu" onAction="#handleSave" styleClass="btn-save"/>
        </HBox>

    </VBox>
</AnchorPane>