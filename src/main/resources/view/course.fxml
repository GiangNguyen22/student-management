<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.desktopapp.controller.CourseController"
            stylesheets="@../css/course.css"
            styleClass="content-pane">
    <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="📖 Quản lý Khóa học" styleClass="header-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleRefresh" styleClass="btn-refresh">
                <graphic>
                    <ImageView fitWidth="100" fitHeight="100" preserveRatio="true">
                        <Image url="@../images/book-icon.png" />
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <VBox spacing="15">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="txtSearch" promptText="🔍 Tìm kiếm khóa học theo mã, tên..."
                          HBox.hgrow="ALWAYS" styleClass="search-field"/>
                <Button onAction="#handleSearch" text="Tìm kiếm" styleClass="btn-search" defaultButton="true"/>
                <Button onAction="#handleAddCourse" text="+ Thêm khóa học" styleClass="btn-add"/>
            </HBox>
            
            <HBox spacing="10">
                <Button onAction="#handleEditCourse" text="✏️ Edit" styleClass="btn-edit" disable="true" fx:id="btnEdit"/>
                <Button onAction="#handleDeleteCourse" text="🗑️ Delete" styleClass="btn-delete" disable="true" fx:id="btnDelete"/>
                <Button onAction="#handleViewDetails" text="👁️ View" styleClass="btn-view" disable="true" fx:id="btnView"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label text="Hiển thị: " styleClass="info-text"/>
                <Label text="0/0 khóa học" styleClass="info-text" fx:id="lblRecordCount"/>
            </HBox>
        </VBox>

        <TableView fx:id="tableCourse" styleClass="table-view" prefHeight="450" onMouseClicked="#handleTableClick" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCourseCode" text="Mã KH" prefWidth="100" resizable="true"/>
                <TableColumn fx:id="colCourseName" text="Tên khóa học" prefWidth="280" resizable="true"/>
                <TableColumn fx:id="colDescription" text="Mô tả" prefWidth="100" resizable="true"/>
                <TableColumn fx:id="colStartDate" text="Ngày bắt đầu" prefWidth="120" resizable="true"/>
                <TableColumn fx:id="colEndDate" text="Ngày kết thúc" prefWidth="120" resizable="true"/>
                <TableColumn fx:id="colStaffCode" text="Mã giảng viên" prefWidth="120" resizable="true"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="15">
            <Label text="📊 Thống kê: " styleClass="info-text"/>
            <Label text="Tổng tín chỉ: 0" styleClass="info-text" fx:id="lblTotalCredits"/>
            <Label text="Kỳ 1: 0 | Kỳ 2: 0" styleClass="info-text" fx:id="lblSemesterStats"/>
        </HBox>
    </VBox>
</AnchorPane>
